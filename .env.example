SUPABASE_DB_HOST=your-project.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your-password-here

# Hevy API
HEVY_API_KEY=your-hevy-api-key-here

# Email alerts (pipeline run outcomes + 25h staleness warning).
# Gmail: SMTP_USER is your full Gmail address; SMTP_PASSWORD is a 16-char
# App Password (Google Account -> Security -> 2-Step Verification -> App
# Passwords), NOT your normal Gmail password. Requires 2FA enabled.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASSWORD=your-16-char-app-password
ALERT_EMAIL_TO=your-gmail-address@gmail.com